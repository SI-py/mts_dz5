            }
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "showValue": "auto",
        "xTickLabelRotation": 0,
        "legend": {
          "showLegend": false,
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        },
        "barRadius": 0,
        "barWidth": 0.9,
        "groupWidth": 0.7,
        "stacking": "none",
        "xTickLabelSpacing": 0,
        "xField": "cat_id",
        "fullHighlight": false
      },
      "description": "Последние 1000 записей всей таблицы, независимо от фильтров и периода. Фрод — решение модели."
    },
    {
      "id": 4,
      "title": "Оборот и сумма под риском",
      "type": "timeseries",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "rawSql": "SELECT $__timeGroupAlias(scored_at, '30s', 0),\n coalesce(sum(amount) FILTER (WHERE fraud_flag = 1), 0)::float8 AS \"Сумма под риском\",\n sum(amount)::float8 AS \"Оборот\"\nFROM scores WHERE $__timeFilter(scored_at) AND us_state IN (${us_state:sqlstring}) AND merch IN (${merch:sqlstring}) GROUP BY 1 ORDER BY 1",
          "format": "time_series",
          "editorMode": "code",
          "rawQuery": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "description": "Сумма транзакций с fraud_flag=1 и общий оборот за 30 секунд. Это потенциальный риск, не подтверждённый ущерб."
    }
