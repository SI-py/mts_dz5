{
  "apiVersion": 1,
  "groups": [
    {
      "orgId": 1,
      "name": "fraud",
      "folder": "Fraud alerts",
      "interval": "10s",
      "rules": [
        {
          "uid": "high-fraud",
          "title": "Доля фрода выше 30%",
          "condition": "B",
          "for": "20s",
          "noDataState": "Alerting",
          "execErrState": "Alerting",
          "labels": {
            "service": "scorer"
          },
          "annotations": {
            "summary": "Доля фрода выше 30%",
            "__dashboardUid__": "scoring",
            "__panelId__": "3"
          },
          "data": [
            {
              "refId": "A",
              "datasourceUid": "prometheus",
              "relativeTimeRange": {
                "from": 60,
                "to": 0
              },
              "model": {
                "refId": "A",
                "expr": "sum(rate(scorer_fraud_total[1m])) / clamp_min(sum(rate(scorer_transactions_total[1m])), 0.001)",
                "instant": true,
                "range": false,
                "datasource": {
                  "type": "prometheus",
                  "uid": "prometheus"
                },
                "intervalMs": 1000,
                "maxDataPoints": 43200
              }
            },
            {
              "refId": "B",
              "datasourceUid": "__expr__",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "model": {
                "refId": "B",
                "type": "threshold",
                "expression": "A",
                "datasource": {
                  "type": "__expr__",
                  "uid": "__expr__"
                },
                "conditions": [
                  {
                    "type": "query",
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        0.3
                      ]
                    },
                    "operator": {
                      "type": "and"
                    },
                    "reducer": {
                      "type": "last",
                      "params": []
                    },
                    "query": {
                      "params": [
                        "B"
                      ]
                    }
                  }
                ]
              }
            }
          ]
        },
        {
          "uid": "stream-stopped",
          "title": "Нет транзакций 20 секунд",
          "condition": "B",
          "for": "20s",
          "noDataState": "Alerting",
          "execErrState": "Alerting",
          "labels": {
            "service": "scorer"
          },
          "annotations": {
            "summary": "Нет транзакций 20 секунд",
            "__dashboardUid__": "scoring",
            "__panelId__": "1"
          },
          "data": [
            {
              "refId": "A",
              "datasourceUid": "prometheus",
              "relativeTimeRange": {
                "from": 60,
                "to": 0
              },
              "model": {
                "refId": "A",
                "expr": "time() - scorer_last_transaction_timestamp_seconds",
                "instant": true,
                "range": false,
                "datasource": {
                  "type": "prometheus",
                  "uid": "prometheus"
                },
                "intervalMs": 1000,
                "maxDataPoints": 43200
              }
            },
            {
              "refId": "B",
              "datasourceUid": "__expr__",
              "relativeTimeRange": {
                "from": 0,
                "to": 0
              },
              "model": {
                "refId": "B",
                "type": "threshold",
                "expression": "A",
                "datasource": {
                  "type": "__expr__",
                  "uid": "__expr__"
                },
                "conditions": [
                  {
                    "type": "query",
                    "evaluator": {
                      "type": "gt",
                      "params": [
                        20
                      ]
                    },
                    "operator": {
                      "type": "and"
                    },
                    "reducer": {
                      "type": "last",
                      "params": []
                    },
                    "query": {
                      "params": [
                        "B"
                      ]
                    }
                  }
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
